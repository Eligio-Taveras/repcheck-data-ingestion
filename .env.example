# =============================================================================
# Environment variables for docker-compose.local.yml
# =============================================================================
# Two ways to provide secrets to the stack:
#
#   1. (Recommended on Windows) Store keys in Windows User env once, then load
#      via the helper before `docker compose up`:
#        [System.Environment]::SetEnvironmentVariable('CONGRESS_GOV_API_KEY', '...', 'User')
#        [System.Environment]::SetEnvironmentVariable('GOVINFO_API_KEY',     '...', 'User')
#      Then in bash:
#        source scripts/ci-functions.sh && loadDevSecrets
#        docker compose -f docker-compose.local.yml up -d
#
#   2. Copy this file to `.env` and fill in literal values. Docker compose
#      auto-loads .env from the compose file's directory. .env is gitignored.
# =============================================================================

# Congress.gov API key — required for fetching bill metadata and text versions
# from api.congress.gov. Sign up at: https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=your-api-key-here

# GovInfo API key — required for bill text body downloads from api.govinfo.gov
# (replaces the Cloudflare-fronted www.congress.gov path that 403s ~30% of raw
# HTTP requests). Sign up at: https://www.govinfo.gov/api-signup
GOVINFO_API_KEY=your-api-key-here

# How many days back to look for bill updates (default: 30)
PIPELINE_LOOKBACK_DAYS=30

# Parallelism for pipeline processing (default: 4)
PIPELINE_PARALLELISM=4

# ---------------------------------------------------------------------------
# Cron schedules (Ofelia format — standard cron with seconds optional)
# Defaults are staggered to avoid concurrent API calls:
#   metadata at :00, checker at :01, text pipeline at :02 past the hour
# ---------------------------------------------------------------------------
# BILL_METADATA_SCHEDULE=0 */6 * * *
# BILL_TEXT_AVAILABILITY_SCHEDULE=0 1,7,13,19 * * *
# BILL_TEXT_PIPELINE_SCHEDULE=0 2,8,14,20 * * *
