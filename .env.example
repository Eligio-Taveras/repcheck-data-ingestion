# =============================================================================
# Environment variables for docker-compose.local.yml
# =============================================================================
# Copy this file to .env and fill in the values before running:
#   docker compose -f docker-compose.local.yml up -d
# =============================================================================

# Congress.gov API key — required for fetching bill metadata and text versions
# Get yours at: https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=your-api-key-here

# How many days back to look for bill updates (default: 30)
PIPELINE_LOOKBACK_DAYS=30

# Parallelism for pipeline processing (default: 4)
PIPELINE_PARALLELISM=4

# ---------------------------------------------------------------------------
# Cron schedules (Ofelia format — standard cron with seconds optional)
# Defaults are staggered to avoid concurrent API calls:
#   metadata at :00, checker at :01, text pipeline at :02 past the hour
# ---------------------------------------------------------------------------
# BILL_METADATA_SCHEDULE=0 */6 * * *
# BILL_TEXT_AVAILABILITY_SCHEDULE=0 1,7,13,19 * * *
# BILL_TEXT_PIPELINE_SCHEDULE=0 2,8,14,20 * * *
