{
  "request": {
    "method": "GET",
    "urlPathPattern": "/v3/bill/[0-9]+/[a-z]+/[0-9]+/actions",
    "queryParameters": {
      "api_key": { "equalTo": "e2e-test-key" }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "bodyFileName": "bill-actions-response.json"
  }
}
